[data-style=neo] .donut div{background:var(--card);box-shadow:6px 6px 14px var(--sh1),-6px -6px 14px var(--sh2)}
[data-style=neo] th{border-bottom:1px solid var(--ln)}
[data-style=neo] td{border-bottom-color:var(--ln)}
[data-style=neo] tr:hover td{background:transparent}
[data-style=neo] .nb{background:color-mix(in srgb,var(--bg) 88%,transparent);border-bottom:0;box-shadow:0 8px 20px -14px var(--sh1)}
[data-style=neo][data-mode=light] .nb .lk a,[data-style=neo] .nb .lk a,[data-style=neo] .hs p,[data-style=neo][data-mode=light] .hs p,[data-style=neo] .mq{color:var(--mu)}
[data-style=neo] .nb .lk a:hover,[data-style=neo] .nb .lk a.h.on{color:var(--pr)}
[data-style=neo] .mqw{border-block:0}
[data-style=neo] .fc:hover{transform:translateY(-4px)}
[data-style=neo] .mbar{background:linear-gradient(135deg,var(--g1),var(--g2));border-radius:0 0 22px 22px}
[data-style=neo] .bnav{background:var(--card);border-top:0;border-radius:24px 24px 0 0;box-shadow:0 -8px 20px -10px var(--sh1)}
[data-style=neo] .mod{background:#cfd8e255;backdrop-filter:blur(8px)}
