[data-style=neo] .btn.out,[data-style=neo] .btn.out:hover{color:#e0425a;background:var(--card)}
[data-style=neo] .btn.rd{background:linear-gradient(135deg,#f0596f,#d62a47)}
[data-style=neo] input,[data-style=neo] select,[data-style=neo] textarea{border:0;border-radius:16px;padding:12px 14px;background:var(--in);box-shadow:inset 4px 4px 9px var(--sh1),inset -4px -4px 9px var(--sh2)}
[data-style=neo] input:focus,[data-style=neo] select:focus,[data-style=neo] textarea:focus{box-shadow:inset 4px 4px 9px var(--sh1),inset -4px -4px 9px var(--sh2),0 0 0 2px color-mix(in srgb,var(--pr) 55%,transparent)}
[data-style=neo] input[type=color]{padding:4px;height:44px;cursor:pointer}
[data-style=neo] .stat{border-radius:var(--r);background:var(--card)!important;color:var(--tx);box-shadow:9px 9px 20px var(--sh1),-9px -9px 20px var(--sh2)}
[data-style=neo] .stat::after{display:none}
[data-style=neo] .stat:hover{box-shadow:11px 11px 24px var(--sh1),-11px -11px 24px var(--sh2)}
[data-style=neo] .stat b{background:linear-gradient(135deg,var(--g1),var(--g2));-webkit-background-clip:text;background-clip:text;color:transparent}
[data-style=neo] .stat span{color:var(--mu);opacity:1}
[data-style=neo] .wc{border-radius:28px;background:linear-gradient(135deg,var(--g1),var(--g2));box-shadow:10px 10px 24px var(--sh1),-8px -8px 20px var(--sh2)}
[data-style=neo] .tag,[data-style=neo] .rk,[data-style=neo] .chip{border:0;box-shadow:inset 2px 2px 5px var(--sh1),inset -2px -2px 5px var(--sh2);background:var(--card)!important}
