[data-style=neo] .pmenu button:hover{background:transparent;box-shadow:inset 3px 3px 7px var(--sh1),inset -3px -3px 7px var(--sh2)}
[data-style=neo] .foot,[data-style=neo] footer{border-top:0}
[data-style=neo] .wheel{border-color:var(--card);box-shadow:8px 8px 18px var(--sh1),-8px -8px 18px var(--sh2)}
[data-style=neo] .auth .card,[data-style=neo] .auth .box{padding:28px}
