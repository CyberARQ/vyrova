/* ===== NEO STYLE (selectable) ===== */
[data-style=neo]{--sh1:#c5cfda;--sh2:#fff;--g1:var(--pr);--g2:var(--pr2);--r:24px}
[data-style=neo][data-theme=blue]{--pr:#3b7bff;--pr2:#1b3df0}
[data-style=neo][data-mode=light]{--bg:#e9eef3;--card:#eef2f6;--bd:#dbe2ea;--tx:#2b3340;--mu:#7b8696;--bg2:#e4eaf0;--in:#e9eef3;--hv:#e6ecf2;--ln:#dde4eb;--sb:#eef2f6;--sh1:#c5cfda;--sh2:#fff}
[data-style=neo][data-mode=dark]{--bg:#1c2028;--card:#21262f;--bd:#2a303b;--bg2:#1a1e25;--in:#1c2028;--hv:#252b35;--ln:#2a303b;--sb:#21262f;--sh1:#13161b;--sh2:#2c323e}
[data-style=neo] body{background:var(--bg)}
[data-style=neo] body::before{background:radial-gradient(700px 500px at 90% -10%,#ffffff99,transparent)!important;animation:none}
[data-style=neo][data-mode=dark] body::before{background:none!important}
[data-style=neo] .card,[data-style=neo] .fc,[data-style=neo] details,[data-style=neo] .box,[data-style=neo] .dd,[data-style=neo] .pmenu,[data-style=neo] .ckb,[data-style=neo] #toast{border:0!important;background:var(--card);border-radius:var(--r);box-shadow:9px 9px 20px var(--sh1),-9px -9px 20px var(--sh2)}
[data-style=neo] .msg,[data-style=neo] .node,[data-style=neo] .who,[data-style=neo] .ann{border:0!important;border-radius:16px;box-shadow:5px 5px 10px var(--sh1),-5px -5px 10px var(--sh2)}
[data-style=neo] .card{padding:20px}
[data-style=neo] .card:hover{box-shadow:11px 11px 24px var(--sh1),-11px -11px 24px var(--sh2)}
[data-style=neo] .msg{background:var(--card)}
[data-style=neo] .msg.a{background:color-mix(in srgb,var(--pr) 10%,var(--card))}
[data-style=neo] .ann{background:var(--card)}
[data-style=neo] aside{border:0;border-radius:28px;background:var(--card);backdrop-filter:none;box-shadow:10px 10px 24px var(--sh1),-10px -10px 24px var(--sh2)}
[data-style=neo] .nav,[data-style=neo][data-mode=light] .nav{border-radius:16px;color:var(--mu)}
[data-style=neo] .nav:hover{background:transparent;transform:none;box-shadow:4px 4px 9px var(--sh1),-4px -4px 9px var(--sh2)}
[data-style=neo] .nav.on,[data-style=neo][data-mode=light] .nav.on{background:var(--card);color:var(--pr);box-shadow:inset 4px 4px 9px var(--sh1),inset -4px -4px 9px var(--sh2)}
[data-style=neo] .nav.on::before{display:none}
[data-style=neo] .logo i,[data-style=neo] .avb{background:linear-gradient(135deg,var(--g1),var(--g2));box-shadow:5px 5px 12px var(--sh1),-4px -4px 10px var(--sh2)}
[data-style=neo] .top{border-bottom:0}
[data-style=neo] .btn{border-radius:18px;padding:11px 22px;background:linear-gradient(135deg,var(--g1),var(--g2));box-shadow:6px 6px 14px var(--sh1),-4px -4px 10px var(--sh2),inset 0 1px 0 #ffffff55}
[data-style=neo] .btn:hover{filter:brightness(1.06);box-shadow:8px 8px 18px var(--sh1),-5px -5px 12px var(--sh2)}
[data-style=neo] .btn:active{box-shadow:inset 3px 3px 8px #0006;transform:scale(.98)}
[data-style=neo] .btn.sm{padding:6px 14px;border-radius:14px}
[data-style=neo] .btn.gh,[data-style=neo] .btn.wh,[data-style=neo] .btn.out,[data-style=neo] .btn.wg{background:var(--card);color:var(--tx);border:0;box-shadow:5px 5px 11px var(--sh1),-5px -5px 11px var(--sh2)}
